{
  "_comment": "One entry per tool. Ages are minutes: <= ok is green, <= warn is amber, beyond is red. Never point a check at a Worker's /state - on BlinkDeal, AmazonGold, FlipkartGold and Deals that route can start a paid sweep. Worker checks hit '/', which answers 404 from a live Worker and has no side effects.",
  "tools": [
    {
      "id": "karatboard", "name": "Karat Board", "mark": "karatboard.svg",
      "url": "https://karatboard.yourcardjourney.store",
      "what": "15 jewellers' 22K/24K rates, re-read every 30 min",
      "checks": [
        {"type": "http", "label": "Site", "url": "https://karatboard.yourcardjourney.store"},
        {"type": "age", "label": "Rates freshness", "url": "https://karatboard.yourcardjourney.store/rates.json", "field": "builtAt", "ok": 75, "warn": 180},
        {"type": "merchants", "label": "Jewellers reading", "url": "https://karatboard.yourcardjourney.store/rates.json", "staleHours": 12, "warnAt": 1, "downAt": 5},
        {"type": "workflow", "label": "Build", "repo": "NishanthBejgam/karat-board", "file": "build.yml"}
      ]
    },
    {
      "id": "karatalerts", "name": "Karat Alerts", "mark": "karatalerts.svg",
      "url": "https://t.me/KaratBoardAlertBot",
      "what": "Telegram spread + jewellery-coupon alerts",
      "checks": [
        {"type": "age", "label": "Alert check ran", "url": "https://karatboard.yourcardjourney.store/alerts.json", "field": "checkedAt", "ok": 75, "warn": 180},
        {"type": "workflow", "label": "Alert build", "repo": "NishanthBejgam/karat-board", "file": "build.yml"}
      ]
    },
    {
      "id": "couponwatch", "name": "Coupon Watch", "mark": "couponwatch.svg",
      "url": "https://github.com/NishanthBejgam/coupon-watch",
