      "checks": [
        {"type": "workflow", "label": "Watcher runs", "repo": "NishanthBejgam/coupon-watch", "file": "watch.yml", "ok": 60, "warn": 180},
        {"type": "json", "label": "Coupon signal", "url": "https://raw.githubusercontent.com/NishanthBejgam/coupon-watch/main/signal/coupon.json", "field": "status", "oneOf": ["live", "none"]}
      ]
